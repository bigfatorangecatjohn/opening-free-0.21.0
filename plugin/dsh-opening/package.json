{
  "name": "dsh-opening-free",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "description": "Boot animation stage for DeepSeek Harness — a full-frame power-on sequence mounted in shell.overlay.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.src.js",
    "cordis.patch.yml",
    "assets/*.wav",
    "assets/*.ogg",
    "assets/*.json",
    "assets/*.png",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
