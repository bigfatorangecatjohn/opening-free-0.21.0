node_modules/
*.log
.tmp/
.DS_Store
Thumbs.db

# 本机 Python 环境（TTS 样音渲染用，可重建，不入库）
.venv-tts/
.pylibs/
**/__pycache__/
*.pyc

# 渲染出来的样音：是给人听的中间产物，正式素材才进 assets/
samples/

# TTS 权重（可重下，单个 300 MB+，绝不入库）
.models/

# 工具脚本的一次性输出
logs/*.out
logs/*.err
tmp*/

demo/raw-*.mp4
demo/seg-*.mp4
demo/concat.txt
demo/master-*.mp4
demo/concat-short.txt
Demo/seg-*-short.mp4
demo/*.png

# 发行物 / 大文件：走 GitHub Release，不进仓库
# （wav 母版可由 tools/build-boot-track.py 重渲；完整版演示片挂 Release）
dist/
plugin/dsh-opening/assets/*.wav
demo/dsh-opening-demo.mp4

# 本机环境备份与第三方参考副本：只在本地留档，不随插件发布
.env-backup/
.ref/

# 用户提供的参考音轨：版权归原片，不入库（只用它的衍生片段）
*.aac
